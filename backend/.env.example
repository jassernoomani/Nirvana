# Copy this file to .env and fill in real values. Never commit .env.

# Local Ollama. No cloud key or paid inference is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=90
# To use an installed Llama model, set LLM_MODEL to its exact Ollama tag.

# No-show prediction (all optional, defaults shown).
# NOSHOW_MEDIUM_RISK=0.15          # from this probability a reservation is "medium" risk and gets a reminder
# NOSHOW_HIGH_RISK=0.30            # from this probability it is "high" risk and gets a second, same-day reminder
# NOSHOW_OVERBOOK_TOLERANCE=0.10   # accepted chance of more guests than tables when suggesting extra bookings
# NOSHOW_OVERBOOK_MAX=2            # never suggest more than this many extra bookings per service
# NOSHOW_RESTAURANT_NAME=Nirvana   # name used in reminder messages
# NOSHOW_OUTBOX_PATH=              # JSON-lines file for reminders (default backend/app/noshow_outbox.jsonl)
